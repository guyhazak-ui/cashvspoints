# Copy this file to .env for local development and fill in real values.
# In production (Vercel), set these as Environment Variables in the
# project dashboard instead of committing a .env file.

# Required -- cash flight prices (https://serpapi.com/manage-api-key)
SERPAPI_KEY="paste-your-serpapi-key-here"

# Required -- award/points availability (https://seats.aero account settings)
SEATS_AERO_API_KEY="paste-your-seats-aero-key-here"

# Optional -- enables the AI Travel Agent mode to use Claude for parsing
# natural-language queries instead of the built-in rule-based fallback.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""
